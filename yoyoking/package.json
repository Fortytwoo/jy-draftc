{
  "name": "@local/dsh-yoyoking",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "Jianying editing, sidebar Douyin login and Harness-managed DouyinCreatorSDK tools",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "config.js", "douyin.js", "douyin-oauth.js", "douyin-service.js", "douyin-process.js", "douyin-host.js", "douyin-api.js", "douyin-mcp.js", "douyin", "video-preview.js", "client.js", "cordis.patch.yml", "locale", "icon.svg", "skills", "runtime", "scripts/check-package.mjs", "scripts/start-douyin.mjs", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-tool", "@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1 || 4.0.5",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1 || 3.18.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.2 || 0.2.1-rc.2"
  },
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "link:harness": "node scripts/link-harness.mjs",
    "prepack": "node scripts/check-package.mjs",
    "test": "node --test tests/*.test.mjs",
    "douyin:start": "node scripts/start-douyin.mjs"
  }
}
