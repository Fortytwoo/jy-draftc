{
  "backend": "douyin-creator-mcp",
  "version": "0.17.2",
  "tools": [
    {
      "name": "douyin_creator_get_work_list",
      "description": "获取当前抖音创作者账号的一页内容列表、作品指标和下一页游标。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "scene": {
            "default": "star_atlas",
            "description": "内容列表场景，默认 star_atlas。",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "default": 0,
            "description": "内容状态筛选；抓包中的全部内容值为 0。",
            "minimum": 0,
            "type": "integer"
          },
          "count": {
            "default": 12,
            "description": "单页返回数量，默认 12，最大 50。",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "max_cursor": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "分页游标；首屏可省略，后续页传上一页返回的 max_cursor。"
          }
        },
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "douyin_creator_export_work_list",
      "description": "导出当前账号所有作品列表到 Excel 文件。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "scene": {
            "default": "star_atlas",
            "description": "内容列表场景，默认 star_atlas。",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "default": 0,
            "description": "内容状态筛选；抓包中的全部内容值为 0。",
            "minimum": 0,
            "type": "integer"
          },
          "filename": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "受控目录内的 .xlsx 文件名；不接受目录或覆盖已有文件。"
          }
        },
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "douyin_creator_download_content",
      "description": "按作品 ID 下载当前账号的视频到服务端受控目录，不暴露临时媒体 URL。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "description": "要下载的作品 ID。",
            "pattern": "^\\d+$",
            "type": "string"
          },
          "filename": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "可选文件名，仅允许当前目录下的 .mp4 文件名；默认使用作品 ID。"
          },
          "overwrite": {
            "default": false,
            "description": "目标文件存在时是否覆盖；默认不覆盖。",
            "type": "boolean"
          },
          "max_size_mb": {
            "default": 512,
            "description": "最大允许下载体积（MB），默认 512。",
            "maximum": 2048,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "item_id"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "douyin_creator_get_item_metrics_trend",
      "description": "获取作品单指标的增量或累计趋势摘要，可选返回完整序列。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "description": "作品 ID。",
            "pattern": "^\\d+$",
            "type": "string"
          },
          "metric": {
            "default": "view_count",
            "description": "要分析的单个指标。",
            "enum": [
              "view_count",
              "subscribe_count",
              "unsubscribe_count",
              "fan_view_proportion",
              "like_count",
              "comment_count",
              "share_count",
              "favorite_count",
              "danmaku_count",
              "completion_rate",
              "bounce_rate_2s",
              "subscribe_rate",
              "unsubscribe_rate",
              "dislike_count",
              "dislike_rate"
            ],
            "type": "string"
          },
          "mode": {
            "default": "cumulative",
            "description": "incremental 为增量，cumulative 为累计值。",
            "enum": [
              "incremental",
              "cumulative"
            ],
            "type": "string"
          },
          "granularity": {
            "default": "day",
            "description": "day 为按日，hour 为按小时。",
            "enum": [
              "day",
              "hour"
            ],
            "type": "string"
          },
          "include_series": {
            "default": false,
            "description": "是否返回完整时间序列；默认只返回统计摘要。",
            "type": "boolean"
          }
        },
        "required": [
          "item_id"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
