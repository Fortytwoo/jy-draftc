    {
      "name": "douyin_web_search_content",
      "description": "按排序、发布时间、时长、范围和内容形式搜索一页公开作品。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "keyword": {
            "description": "搜索关键词。",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "sort": {
            "default": "relevance",
            "description": "排序方式。",
            "enum": [
              "relevance",
              "most_liked",
              "latest"
            ],
            "type": "string"
          },
          "published_within": {
            "default": "any",
            "description": "发布时间范围。",
            "enum": [
              "any",
              "day",
              "week",
              "half_year"
            ],
            "type": "string"
          },
          "duration": {
            "default": "any",
            "description": "视频时长范围。",
            "enum": [
              "any",
              "under_1m",
              "1_to_5m",
              "over_5m"
            ],
            "type": "string"
          },
          "scope": {
            "default": "any",
            "description": "搜索范围。",
            "enum": [
              "any",
              "watched",
              "unwatched",
              "following"
            ],
            "type": "string"
          },
          "content_type": {
            "default": "any",
            "description": "内容形式。",
            "enum": [
              "any",
              "video",
              "image_text"
            ],
            "type": "string"
          },
          "offset": {
            "default": 0,
            "description": "结果偏移量。",
            "minimum": 0,
            "type": "integer"
          },
          "search_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "翻页所需的搜索会话标识；首屏省略，后续页传上一页返回值。"
          }
        },
        "required": [
          "keyword"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
